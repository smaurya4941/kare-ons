# =============================================================================
# PRODUCTION ENVIRONMENT TEMPLATE — copy to .env on the server and fill in.
# Never commit the real .env. Generate APP_KEY with: php artisan key:generate
# =============================================================================

APP_NAME="Kare ONS Herbals"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-domain.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

# Keep logs quiet in production; use 'daily' so they rotate.
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# ---- Database (use MySQL/Postgres in production, not sqlite) ----------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=kareons
DB_USERNAME=kareons
DB_PASSWORD=

# ---- Sessions / cache / queue ----------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Force secure cookies once you are on HTTPS:
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# A worker MUST run for order emails to send: php artisan queue:work
QUEUE_CONNECTION=database
CACHE_STORE=database

# ---- Mail (order confirmations / shipping updates) -------------------------
# Order emails are queued; without a real mailer + running worker they are lost.
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SCHEME=tls
MAIL_FROM_ADDRESS="orders@your-domain.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# NOTE: Razorpay key / secret / webhook secret are NOT set here — configure them
# in Admin -> Settings -> Payment (they are stored in the database).
