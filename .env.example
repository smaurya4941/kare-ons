APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# Storefront mode  (see config/storefront.php)
# ---------------------------------------------------------------------------
# 'blade'    — this Laravel app serves the customer storefront (DEFAULT;
#              production runs this today).
# 'headless' — the Next.js app (kare-ons-web) serves the storefront against
#              /api/v1; the Blade storefront routes become 302 shims to
#              STOREFRONT_URL. Flip to this ONLY once the Next.js app is
#              hosted.
STOREFRONT_MODE=blade
# Base URL of the deployed Next.js storefront (used only when headless).
# STOREFRONT_URL=https://kareonsherbal.com

# Optional: base URL of a separate headless frontend consuming routes/api.php.
# Used for the API's CORS allowlist and to build password-reset /
# email-verification links for API (api/*) requests. Leave unset to keep this
# app standalone — CORS defaults to "*" (safe: Bearer tokens, no cookies) and
# those links fall back to APP_URL. Set this once the Next.js app is deployed.
# FRONTEND_URL=https://kareonsherbal.com

# Shared secret the Next.js storefront sends as the `X-Frontend-Key` header on
# every API call. Requests carrying it get the first-party rate-limit budget
# (1200/min) instead of the public per-IP limit (60/min) — needed because all
# storefront traffic reaches this API from a few Vercel server IPs. Must match
# API_INTERNAL_KEY in the Next.js env. Leave unset to disable (all callers
# then share the public limit). Generate with: openssl rand -hex 32
# FRONTEND_API_KEY=

# Minutes before a Sanctum API token expires (30 days).
SANCTUM_TOKEN_EXPIRATION=43200
